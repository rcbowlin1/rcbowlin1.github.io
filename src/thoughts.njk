---
layout: base.njk
title: Thoughts
---
<section class="page-head">
  <h1>Thoughts</h1>
  <p class="section-note">A collection of thoughts and debates between me and AI. Sharing them here for others — enjoy.</p>
</section>

<section>
  {% if collections.posts and collections.posts.length %}
  <div class="thoughts-controls">
    <div class="filter-group" role="group" aria-label="Filter by track">
      <button class="filter-btn is-active" data-filter="all">All</button>
      <button class="filter-btn" data-filter="Work">Work</button>
      <button class="filter-btn" data-filter="Play">Play</button>
    </div>
    <button class="sort-btn" data-order="desc" aria-label="Sort by date">Newest first ↓</button>
  </div>

  <ul class="post-index" id="post-index">
    {%- for post in collections.posts | reverse %}
    <li data-track="{{ post.data.track }}" data-date="{{ post.date | isoDate }}">
      <a href="{{ post.url }}">{{ post.data.title }}</a>
      <span class="post-meta">{{ post.date | readableDate }} · {{ post.data.category }} · <span class="post-track">{{ post.data.track }}</span></span>
    </li>
    {%- endfor %}
  </ul>

  <p class="post-empty" hidden>Nothing here under that filter — yet.</p>

  <script>
  (function () {
    var list = document.getElementById('post-index');
    if (!list) return;
    var items = Array.prototype.slice.call(list.children);
    var filterBtns = document.querySelectorAll('.filter-btn');
    var sortBtn = document.querySelector('.sort-btn');
    var empty = document.querySelector('.post-empty');
    var currentFilter = 'all';

    function applyFilter() {
      var visible = 0;
      items.forEach(function (li) {
        var show = currentFilter === 'all' || li.getAttribute('data-track') === currentFilter;
        li.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      if (empty) empty.hidden = visible !== 0;
    }
    function applySort(order) {
      items.slice().sort(function (a, b) {
        var da = a.getAttribute('data-date'), db = b.getAttribute('data-date');
        if (da === db) return 0;
        return order === 'asc' ? (da < db ? -1 : 1) : (da > db ? -1 : 1);
      }).forEach(function (li) { list.appendChild(li); });
    }
    filterBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        filterBtns.forEach(function (b) { b.classList.remove('is-active'); });
        btn.classList.add('is-active');
        currentFilter = btn.getAttribute('data-filter');
        applyFilter();
      });
    });
    if (sortBtn) {
      sortBtn.addEventListener('click', function () {
        var order = sortBtn.getAttribute('data-order') === 'desc' ? 'asc' : 'desc';
        sortBtn.setAttribute('data-order', order);
        sortBtn.textContent = order === 'desc' ? 'Newest first ↓' : 'Oldest first ↑';
        applySort(order);
      });
    }
    applySort('desc'); // default: newest first
  })();
  </script>
  {% else %}
  <p class="placeholder">[ First post coming soon — the deterministic-vs-agentic piece. ]</p>
  {% endif %}
</section>

<section class="backlog">
  <h2>The Backlog</h2>
  <p class="section-note">We run agile around here… (I'm probably working on a new feature)</p>
  <ul class="post-index backlog-list">
    {%- for item in backlog %}
    <li>
      <a href="/posts/{{ item.slug }}/">{{ item.title }}</a>
      <span class="post-meta">{{ item.track }} · not yet written</span>
    </li>
    {%- endfor %}
  </ul>
</section>
