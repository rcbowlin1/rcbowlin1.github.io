---
layout: base.njk
title: Thoughts
---
<section class="page-head">
  <h1>Thoughts</h1>
  <p class="section-note">Notes on building and shipping applied AI.</p>
</section>

<section>
  {% if collections.posts and collections.posts.length %}
  <ul class="post-index">
    {%- for post in collections.posts | reverse %}
    <li>
      <a href="{{ post.url }}">{{ post.data.title }}</a>
      <span class="post-meta">{{ post.date | readableDate }}</span>
    </li>
    {%- endfor %}
  </ul>
  {% else %}
  <p class="placeholder">[ First post coming soon — the deterministic-vs-agentic piece. ]</p>
  {% endif %}
</section>
