<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  {% set pageTitle = (title + " · " + site.name) if title else site.name %}
  {% set pageDesc = description or site.description %}
  {% set pageUrl = (site.url + page.url) %}
  {% set ogImageUrl = (site.url + site.ogImage) %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}" />
  <link rel="canonical" href="{{ pageUrl }}" />

  <!-- Open Graph (LinkedIn, Slack, Facebook, iMessage) -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="{{ site.name }}" />
  <meta property="og:title" content="{{ pageTitle }}" />
  <meta property="og:description" content="{{ pageDesc }}" />
  <meta property="og:url" content="{{ pageUrl }}" />
  <meta property="og:image" content="{{ ogImageUrl }}" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Ryan Bowlin — Product Manager, Applied AI" />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ pageTitle }}" />
  <meta name="twitter:description" content="{{ pageDesc }}" />
  <meta name="twitter:image" content="{{ ogImageUrl }}" />

  <link rel="icon" href="/img/favicon.png" type="image/png" />
  <link rel="stylesheet" href="/css/styles.css" />
</head>
<body>
  <header class="site-header">
    <a class="wordmark" href="/">Ryan Bowlin</a>
    <nav>
      <a href="/">Home</a>
      <a href="/about/">About</a>
      <a href="/work/">Work</a>
      <a href="/thoughts/">Thoughts</a>
      <a class="nav-cta-outline" href="/resume/">Résumé</a>
      <a class="nav-cta" href="/connect/">Connect</a>
    </nav>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="site-footer" id="contact">
    <p class="disclaimer">This page and everything on it was created with AI as a way to further learn its capabilities.<br />Pardon any errors, hallucinations, or eye-rolling content. Pretty cool though, huh?</p>
    <div class="contact">
      <span class="contact-name">Ryan Bowlin</span>
      <a href="mailto:rcbowlin1@gmail.com">Email</a>
      <a href="https://www.linkedin.com/in/ryan-bowlin/">LinkedIn</a>
      <a href="https://github.com/rcbowlin1">GitHub</a>
    </div>
    <p class="copyright">© <span id="year"></span> Ryan Bowlin</p>
  </footer>

  <script>
    document.getElementById('year').textContent = new Date().getFullYear();
    // External links open in a new tab.
    document.querySelectorAll('a[href^="http"]').forEach(function (a) {
      if (a.host !== location.host) { a.target = '_blank'; a.rel = 'noopener noreferrer'; }
    });
  </script>
</body>
</html>
