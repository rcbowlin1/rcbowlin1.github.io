---
layout: base.njk
---
<article class="post">
  <p class="post-meta">{{ page.date | readableDate }}{% if category %} · {{ category }}{% endif %}{% if track %} · <span class="post-track">{{ track }}</span>{% endif %}</p>
  <h1>{{ title }}</h1>
  {{ content | safe }}
  <p class="back"><a href="/thoughts/">← All thoughts</a></p>
</article>
