  <script>
  (function(){
    const $=id=>document.getElementById(id);
    const DB=JSON.parse($('rgData').textContent);
    let IDF={},DOCV=[],N=0;
    const toks=s=>(s.toLowerCase().match(/[a-z0-9][a-z0-9.\-]*/g)||[]);
    function vec(s){const tf={};toks(s).forEach(t=>tf[t]=(tf[t]||0)+1);const v={};let n=0;
      for(const t in tf){const w=(1+Math.log(tf[t]))*(IDF[t]||Math.log(N+1)+1);v[t]=w;n+=w*w;}
      n=Math.sqrt(n)||1;for(const t in v)v[t]/=n;return v;}
    (function(){const df={};N=DB.corpus.length;
      DB.corpus.forEach(d=>{[...new Set(toks(d.text))].forEach(t=>df[t]=(df[t]||0)+1);});
      for(const t in df)IDF[t]=Math.log((N+1)/(df[t]+1))+1;
      DOCV=DB.corpus.map(d=>[d,vec(d.text)]);})();
    function retrieve(q,k){k=k||8;const qv=vec(q);
      return DOCV.map(([d,dv])=>{let s=0;for(const t in qv)if(dv[t])s+=qv[t]*dv[t];return [s,d];})
        .sort((a,b)=>b[0]-a[0]).slice(0,k).map(x=>x[1]);}
    const field=(t,lab)=>{const m=t.match(new RegExp(lab+' (\\d[\\d,]*\\.\\d{2})','i'));return m?parseFloat(m[1].replace(/,/g,'')):null;};
    const INV=()=>DB.invoices,PAY=()=>DB.payments;
    const invNum=i=>i.invoice_number||i.source.split('#').pop();
    function vendorIn(q){const ql=q.toLowerCase();
      const names=[...new Set(INV().map(i=>i.vendor_name).filter(Boolean))].sort((a,b)=>b.length-a.length);
      for(const v of names){if(ql.includes(v.toLowerCase())||ql.includes(v.toLowerCase().split(' ')[0]))return v;}return null;}
    function pureRag(q){const ql=q.toLowerCase(),hits=retrieve(q,8),inv=hits.filter(h=>h.kind==='invoice');
      const srcs=hits.map(h=>h.id);
      if(/how much|total (paid|value)|spent|spend/.test(ql)){const v=vendorIn(q);
        if(v){const rows=inv.filter(h=>h.text.toLowerCase().includes(v.split(' ')[0].toLowerCase()));
          const paid=rows.map(h=>field(h.text,'paid')).filter(x=>x!==null);
          return {value:paid.length?Math.round(paid.reduce((a,b)=>a+b,0)*100)/100:null,unit:'usd',sources:rows.map(h=>h.id).length?rows.map(h=>h.id):srcs};}
        if(ql.includes('unpaid')){const rows=inv.filter(h=>h.text.includes('OPEN_UNPAID'));
          const tot=rows.map(h=>field(h.text,'(?<![a-z])total')).filter(x=>x!==null);
          return {value:tot.length?Math.round(tot.reduce((a,b)=>a+b,0)*100)/100:null,unit:'usd',sources:rows.map(h=>h.id)};}}
      if(/how many|number of|count/.test(ql)){
        const pred=ql.includes('unpaid')?'OPEN_UNPAID':(/exception|flagged/.test(ql))?'EXCEPTION':ql.includes('duplicate')?'DUPLICATE_INVOICE':null;
        if(pred)return {value:inv.filter(h=>h.text.includes(pred)).length,unit:'count',sources:inv.map(h=>h.id)};}
      if(/which invoices|list|missing|over (their|the) po|no purchase order/.test(ql)){
        const pred=/missing|no purchase/.test(ql)?'MISSING_PO':/over (their|the) po|billed more/.test(ql)?'AMOUNT_MISMATCH_PO':null;
        if(pred){const rows=inv.filter(h=>h.text.includes(pred));
          return {set:rows.map(h=>h.text.match(/Invoice (\S+) from/)[1]).sort(),sources:rows.map(h=>h.id)};}}
      const top=hits[0];let val=null;
      if(top){if(/\bpo\b|purchase order/.test(ql)){const m=top.text.match(/PO (PO-\d+|none)/);val=m?m[1]:null;}
        else{const lab=(/subtotal|before tax/.test(ql))?'subtotal':/tax/.test(ql)?'tax':'(?<![a-z])total';
          val=field(top.text,lab);
          if(val===null){const mon=top.text.match(/\d[\d,]*\.\d{2}/g);if(mon)val=parseFloat(mon[mon.length-1].replace(/,/g,''));}}}
      return {value:val,unit:(typeof val==='number'?'usd':null),sources:srcs};}
    function route(q){const ql=q.toLowerCase(),up=q.toUpperCase();
      const ref=INV().map(invNum).find(n=>new RegExp('(?<![\\w-])'+n.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')+'(?![\\w-])').test(up));
      if(ref)return ['lookup',ref];
      if(/no matching invoice|unmatched|no invoice behind/.test(ql))return ['list','unmatched'];
      if(/missing|without a (purchase order|po)|no purchase order/.test(ql))return ['list','MISSING_PO'];
      if(/over their po|over the po|billed more|more than (its|their) po|mismatch/.test(ql))return ['list','AMOUNT_MISMATCH_PO'];
      if(/how much|total (paid|value)|sum|spend|spent/.test(ql)&&vendorIn(q))return ['agg','paid_vendor'];
      if(/how many|number of|count/.test(ql)||/total (dollar )?value/.test(ql))return ['agg','count'];
      return ['lookup',null];}
    const FIELD=[['po','po_number'],['subtotal','subtotal'],['before tax','subtotal'],['tax','tax'],['date','invoice_date'],['total','total'],['paid','amount_paid']];
    function hybrid(q){const r=route(q),kind=r[0],arg=r[1],ql=q.toLowerCase();
      if(kind==='lookup'&&arg){const i=INV().find(x=>invNum(x)===arg);
        const f=(FIELD.find(x=>ql.includes(x[0]))||[,'total'])[1];
        return {value:i[f],unit:(['total','subtotal','tax','amount_paid'].includes(f)?'usd':null),sources:[i.source],path:'structured-lookup'};}
      if(kind==='lookup'){const x=pureRag(q);x.path='retrieval';return x;}
      if(kind==='list'){if(arg==='unmatched'){const s=PAY().filter(p=>p.status==='UNMATCHED_PAYMENT').map(p=>p.bank_ref+':'+p.amount.toFixed(2)).sort();
          return {set:s,sources:[],path:'structured-query'};}
        const rows=INV().filter(i=>(i.exceptions||[]).includes(arg));
        return {set:rows.map(invNum).sort(),sources:rows.map(i=>i.source),path:'structured-query'};}
      if(kind==='agg'&&arg==='paid_vendor'){const v=vendorIn(q),rows=INV().filter(i=>i.vendor_name===v&&i.bank_refs&&i.bank_refs.length);
        return {value:Math.round(rows.reduce((a,i)=>a+i.amount_paid,0)*100)/100,unit:'usd',sources:rows.map(i=>i.source),path:'structured-query'};}
      if(kind==='agg'){if(ql.includes('unpaid')&&/value|dollar|amount/.test(ql)){const rows=INV().filter(i=>i.status==='OPEN_UNPAID');
          return {value:Math.round(rows.reduce((a,i)=>a+i.total,0)*100)/100,unit:'usd',sources:rows.map(i=>i.source),path:'structured-query'};}
        let rows;
        if(ql.includes('unpaid'))rows=INV().filter(i=>i.status==='OPEN_UNPAID');
        else if(ql.includes('exception')||ql.includes('flagged'))rows=INV().filter(i=>i.status==='EXCEPTION');
        else if(ql.includes('duplicate'))rows=INV().filter(i=>(i.exceptions||[]).includes('DUPLICATE_INVOICE'));
        else return {value:null,sources:[],path:'needs-review'};
        return {value:rows.length,unit:'count',sources:rows.map(i=>i.source),path:'structured-query'};}
      return {value:null,sources:[],path:'needs-review'};}
    const isNum=x=>typeof x==='number';
    function fmt(a){if(a.set)return a.set.length?a.set.join(', '):'(none found)';
      if(a.value===null||a.value===undefined)return "can't answer";
      if(a.unit==='count')return String(a.value);
      if(isNum(a.value))return '$'+a.value.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});
      return a.value;}
    function same(a,b){if(a.set||b.set)return JSON.stringify(a.set||[])===JSON.stringify(b.set||[]);
      if(isNum(a.value)&&isNum(b.value))return Math.abs(a.value-b.value)<=0.01;
      return String(a.value).toLowerCase()===String(b.value).toLowerCase();}
    function ask(q){$('rgQ').value=q;const det=hybrid(q),rag=pureRag(q);
      $('rgDetAns').textContent=fmt(det);$('rgDetAns').className='rg-answer'+(det.set?' rg-list':'');
      $('rgRagAns').textContent=fmt(rag);$('rgRagAns').className='rg-answer'+(rag.set?' rg-list':'');
      $('rgDetBadge').innerHTML='<span class="rg-badge rg-ok">✓ verified against the ledger</span>';
      const hit=same(rag,det);
      $('rgRagBadge').innerHTML='<span class="rg-badge '+(hit?'rg-ok':'rg-no')+'">'+(hit?'✓ matches':'✗ wrong')+'</span>';
      $('rgDetMeta').innerHTML='<b>'+det.path+'</b>'+(det.sources&&det.sources.length?' · cites '+det.sources.length+' row'+(det.sources.length>1?'s':''):'');
      $('rgRagMeta').innerHTML='pulled <b>'+rag.sources.length+'</b> chunks · <span class="rg-srcf">'+(rag.sources[0]||'').split('/').pop()+'</span>';
      $('rgNote').textContent=hit?'Retrieval handled this one. It shines when the answer sits on a single document.'
        :'Retrieval answered from what it pulled and missed. Totals, counts and lists need every row, so the router sends them to code.';}
    $('rgRagBench').textContent='benchmark '+DB.benchmark.rag.overall[0]+'/'+DB.benchmark.rag.overall[1];
    $('rgDetBench').textContent='benchmark '+DB.benchmark.hybrid.overall[0]+'/'+DB.benchmark.hybrid.overall[1];
    DB.examples.forEach(e=>{const c=document.createElement('span');c.className='rg-chip';c.textContent=e.q;
      c.onclick=()=>ask(e.q);$('rgChips').appendChild(c);});
    $('rgAsk').addEventListener('submit',ev=>{ev.preventDefault();if($('rgQ').value.trim())ask($('rgQ').value.trim());});
    ask(DB.examples[9].q);
  })();
  </script>
  {% endraw %}

  <h2>What the eval showed</h2>
  <table class="scorecard">
    <thead><tr><th>Question type</th><th>Retrieval only</th><th>Routed to code</th></tr></thead>
    <tbody>
      <tr><td>Look-up (one document)</td><td>7 / 7</td><td>7 / 7</td></tr>
      <tr><td>Aggregate (total, count)</td><td>3 / 6</td><td>6 / 6</td></tr>
      <tr><td>List (which invoices…)</td><td>2 / 3</td><td>3 / 3</td></tr>
      <tr><td><strong>Overall</strong></td><td><strong>12 / 16</strong></td><td><strong>16 / 16</strong></td></tr>
    </tbody>
  </table>
  <p>
    Retrieval ties on look-ups and even gets the small totals and lists, because those fit inside what
    it pulled back. It breaks on the questions that need every row. It counts 2 exceptions when there
    are 12, because it only saw the two it retrieved. The routed side gets all 16, and it shows its row
    count every time, so you can check it.
  </p>

  <h2>What I learned</h2>
  <p>
    Retrieval is not a database, and it rarely tells you so. When it undercounts, the answer still
    looks like an answer, a confident 2 where the truth is 12. That's the real risk with RAG on
    business data. It doesn't fail loudly, it's right often enough that you stop checking, and then
    it's quietly wrong on the one that matters. The fix isn't a smarter model, it's structure: route
    the questions that need completeness to code, and make every answer carry the rows behind it so a
    person can verify it.
  </p>
  <p>
    I caught all of this because of the eval. Without it I'd have a question box that looks impressive
    and a 75 I'd have taken for a 95. It turned "it mostly works" into "here is exactly where it
    doesn't," the same habit I wrote about in
    <a href="/posts/ai-evals/">AI Evals: Grading your own homework</a>. I could keep going from here,
    with real embeddings, a stronger retriever, a model to phrase the answers, and a threshold that
    bows out when it isn't sure, and a production system would. But the data here is synthetic and
    small and the retriever is deliberately simple, and chasing a better number would miss the point
    of this site, which is to learn the shape of a problem, not to ship a product. The shape is clear
    enough: retrieval for finding, code for counting, and an eval to tell you where the line is.
  </p>

